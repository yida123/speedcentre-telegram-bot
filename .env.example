# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=123456:ABC-DEF
# SpeedCentre+ 用户 API Key
SCP_API_KEY=your-api-key
# API 地址，一般无需修改
SCP_API_BASE=https://api.speedcentre.plus

# 允许使用 bot 的群组 ID，逗号分隔（先留空，在群里发 /id 拿到后再填；留空表示任何群都能用，会消耗你的积分）
ALLOWED_CHAT_IDS=
# 超级管理员用户 ID，逗号分隔（私聊 bot 发 /id 查看）。管理员可手动测速本机场订阅（/speed、/autotest），测速不限次数，
# 并可在私聊里用命令修改授权群、本机场订阅、自动测速时间等设置（发 /settings 查看）；
# 超级管理员还可以用 /admin add 添加普通管理员。命令修改的设置保存在 DATA_DIR/settings.json，优先于本文件
ADMIN_USER_IDS=

# 本机场订阅配置文件（参考 subscriptions.example.yaml），用于每日自动测速和管理员手动测速
SUBSCRIPTIONS_FILE=subscriptions.yaml
# 自动测速时间（按 TIMEZONE），可以写：
#   每天固定时间      09:00,21:00
#   固定间隔          6h（每 6 小时整点）、30m（每 30 分钟），需能整除 1 小时或 24 小时
#   5 段 cron 表达式  0 8-22/2 * * *（8 点到 22 点每 2 小时）、30 9 * * 1-5（工作日 09:30）
# 两次至少间隔 10 分钟。不写这一行默认 09:00，写成空值则不自动测速。管理员也可以在私聊里发 /schedule 修改
SCHEDULE_TIMES=09:00
# 自动测速结果发到哪些群，逗号分隔；留空则发到所有 ALLOWED_CHAT_IDS（设置了授权群时，只发给其中仍是授权群的群）
AUTO_CHAT_IDS=
# 自动测速使用的后端 ID；留空使用 DEFAULT_SLAVE_ID 或自动选择
AUTO_SLAVE_ID=
# 群成员私聊测自己订阅的每日次数，0 或留空表示不限（默认）；管理员和自动测速不计入
DAILY_LIMIT=0
# 群成员两次测速至少间隔多少秒，0 表示不限（管理员不受限）
COOLDOWN_SECONDS=0
# 群成员单次最多测多少个节点，0 表示只受 MAX_NODES 限制（管理员不受限）
MEMBER_MAX_NODES=0
# 当天积分消耗超过该值时私聊提醒管理员（每天一次），0 表示不提醒
CREDIT_ALERT=0
# 本机场自动测速失败、或没有速度的节点占比达到该百分比时私聊提醒管理员，0 表示不提醒
ANOMALY_ALERT_PERCENT=50
# 置顶最新一轮本机场测速结果（并取消置顶上一轮的），需要 bot 有置顶消息权限
PIN_AUTO_RESULT=true
# “每天”按哪个时区计算
TIMEZONE=Asia/Shanghai
# 测速次数、统计和管理员设置的保存目录（systemd 部署时由服务自动设置为 /var/lib/speed-bot）
DATA_DIR=data

# 单次测试最多节点数
MAX_NODES=100
# 每个群同时运行的任务数
MAX_TASKS_PER_CHAT=1
# 默认后端 ID，留空自动选择
DEFAULT_SLAVE_ID=
# 允许用户选择的后端 ID，逗号分隔；留空表示所有允许 Copilot 调用的在线后端（见 /backends）
ALLOWED_BACKENDS=
# 测速前是否让用户用按钮选择后端（true/false）
BACKEND_SELECT=true
# 测速前是否让用户选择结果排序方式（true/false）；关闭时按平均速度降序
SORT_SELECT=true
# 网页查看任务的链接模板，{task_id} 会被替换；留空则不显示「在 SpeedCentre+ 查看」按钮
SCP_TASK_URL=
# 留空（默认）不创建分享、结果图下不附链接。想附上「📊 查看详情」分享链接（隐藏节点地址等敏感信息）时填：
# SCP_SHARE_URL=https://web.speedcentre.plus/share?share_id={uuid}
SCP_SHARE_URL=
# 群里除测速结果外的消息（提示、菜单、进度消息、用户发的命令）多少秒后删除，留空默认 10 秒，0 表示不删。
# 进度消息在结果图发出后才开始计时（结果没能发出时保留，供 /result 取回）；私聊消息不删。需要 bot 是群管理员并有删除消息权限
AUTO_DELETE_SECONDS=10
# 群里出现节点链接或疑似订阅链接时自动删除（防止订阅泄露，需要 bot 是群管理员并有删除消息权限）
DELETE_SUB_MESSAGE=true
# 判断“疑似订阅链接”的正则（匹配 http/https 链接），留空使用内置规则
SUB_LINK_PATTERN=
# 测速配置（每次提交都会完整发送；后端当前在缺少这些配置时会异常断连）。留空使用默认值，
# 默认值与 SpeedCentre+ 官方文档的对接示例一致
# 测速下载文件地址，默认 dl.google.com 上的 Android Studio 安装包。也可以填：
#   INTL_ANTIHIJACK                 使用后端内置的反劫持测速（以 google.com 伪装测速流量）
#   你的CNAME域名 > 下载URL          自定义反劫持测速
#   https://t.me/某公开频道/消息ID     Telegram 下载测速
SPEED_DOWNLOAD_URL=
# 测速时长（秒）与线程数
SPEED_DURATION=8
SPEED_THREADS=4
# 延迟测试地址与取平均的次数
PING_URL=
PING_AVERAGE_OVER=3
# UDP NAT 类型检测使用的 STUN 服务器
STUN_URL=
# 节点测试失败时的重试次数
TASK_RETRY=3
# 节点域名解析使用的 DNS，逗号分隔；留空使用后端默认
DNS_SERVERS=
# 进度刷新间隔（秒）与任务超时（秒）
POLL_INTERVAL=5
TASK_TIMEOUT=1800
