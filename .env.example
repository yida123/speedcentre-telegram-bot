# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=123456:ABC-DEF
# SpeedCentre+ 用户 API Key
SCP_API_KEY=your-api-key
# API 地址，一般无需修改
SCP_API_BASE=https://api.speedcentre.plus

# 允许使用 bot 的群组 ID，逗号分隔；留空表示不限制（不推荐，会消耗你的积分）
ALLOWED_CHAT_IDS=-1001234567890
# 管理员用户 ID，逗号分隔；管理员可在任何会话使用，并可取消他人任务
ADMIN_USER_IDS=123456789
# 是否允许不属于任何授权群的用户私聊测试（结果发回私聊）；授权群成员总是可以私聊提交、结果发回群里
ALLOW_PRIVATE=false

# 单次测试最多节点数
MAX_NODES=100
# 每个群同时运行的任务数
MAX_TASKS_PER_CHAT=1
# 默认后端 ID，留空自动选择
DEFAULT_SLAVE_ID=
# 允许用户选择的后端 ID，逗号分隔；留空表示所有允许 Copilot 调用的在线后端（见 /backends）
ALLOWED_BACKENDS=
# 测试前是否让用户用按钮选择后端（true/false）
BACKEND_SELECT=true
# 群里出现节点链接或疑似订阅链接时自动删除（防止订阅泄露，需要 bot 是群管理员并有删除消息权限）
DELETE_SUB_MESSAGE=true
# 判断“疑似订阅链接”的正则（匹配 http/https 链接），留空使用内置规则
SUB_LINK_PATTERN=
# 进度刷新间隔（秒）与任务超时（秒）
POLL_INTERVAL=5
TASK_TIMEOUT=1800
