# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=123456:ABC-DEF
# SpeedCentre+ 用户 API Key
SCP_API_KEY=your-api-key
# API 地址，一般无需修改
SCP_API_BASE=https://api.speedcentre.plus

# 允许使用 bot 的群组 ID，逗号分隔（先留空，在群里发 /id 拿到后再填；留空表示任何群都能用，会消耗你的积分）
ALLOWED_CHAT_IDS=
# 管理员用户 ID，逗号分隔；管理员可手动测速本机场订阅（/speed、/autotest），测速不限次数
ADMIN_USER_IDS=

# 本机场订阅配置文件（参考 subscriptions.example.yaml），用于每日自动测速和管理员手动测速
SUBSCRIPTIONS_FILE=subscriptions.yaml
# 每日自动测速时间（按 TIMEZONE），逗号分隔，例如 09:00,21:00；不写这一行默认 09:00，写成空值则不自动测速
SCHEDULE_TIMES=09:00
# 自动测速结果发到哪些群，逗号分隔；留空则发到所有 ALLOWED_CHAT_IDS
AUTO_CHAT_IDS=
# 自动测速使用的后端 ID；留空使用 DEFAULT_SLAVE_ID 或自动选择
AUTO_SLAVE_ID=
# 群成员私聊测自己订阅的每日次数，0 或留空表示不限（默认）；管理员和自动测速不计入
DAILY_LIMIT=0
# “每天”按哪个时区计算
TIMEZONE=Asia/Shanghai
# 测速次数记录的保存目录（systemd 部署时由服务自动设置为 /var/lib/speed-bot）
DATA_DIR=data

# 单次测试最多节点数
MAX_NODES=100
# 每个群同时运行的任务数
MAX_TASKS_PER_CHAT=1
# 默认后端 ID，留空自动选择
DEFAULT_SLAVE_ID=
# 允许用户选择的后端 ID，逗号分隔；留空表示所有允许 Copilot 调用的在线后端（见 /backends）
ALLOWED_BACKENDS=
# 测速前是否让用户用按钮选择后端（true/false）
BACKEND_SELECT=true
# 测速前是否让用户选择结果排序方式（true/false）；关闭时按平均速度降序
SORT_SELECT=true
# 网页查看任务的链接模板，{task_id} 会被替换；留空则不显示「在 SpeedCentre+ 查看」按钮
SCP_TASK_URL=
# 留空（默认）不创建分享、结果图下不附链接。想附上「📊 查看详情」分享链接（隐藏节点地址等敏感信息）时填：
# SCP_SHARE_URL=https://web.speedcentre.plus/share?share_id={uuid}
SCP_SHARE_URL=
# 群里除测速结果外的消息（提示、菜单、进度消息、用户发的命令）多少秒后删除，留空默认 10 秒，0 表示不删。
# 进度消息在结果图发出后才开始计时；私聊消息不删。需要 bot 是群管理员并有删除消息权限
AUTO_DELETE_SECONDS=10
# 群里出现节点链接或疑似订阅链接时自动删除（防止订阅泄露，需要 bot 是群管理员并有删除消息权限）
DELETE_SUB_MESSAGE=true
# 判断“疑似订阅链接”的正则（匹配 http/https 链接），留空使用内置规则
SUB_LINK_PATTERN=
# 测速配置（每次提交都会完整发送；后端当前在缺少这些配置时会异常断连）。留空使用默认值，
# 默认值与 SpeedCentre+ 官方文档的对接示例一致
# 测速下载文件地址，默认 dl.google.com 上的 Android Studio 安装包。也可以填：
#   INTL_ANTIHIJACK                 使用后端内置的反劫持测速（以 google.com 伪装测速流量）
#   你的CNAME域名 > 下载URL          自定义反劫持测速
#   https://t.me/某公开频道/消息ID     Telegram 下载测速
SPEED_DOWNLOAD_URL=
# 测速时长（秒）与线程数
SPEED_DURATION=8
SPEED_THREADS=4
# 延迟测试地址与取平均的次数
PING_URL=
PING_AVERAGE_OVER=3
# UDP NAT 类型检测使用的 STUN 服务器
STUN_URL=
# 节点测试失败时的重试次数
TASK_RETRY=3
# 节点域名解析使用的 DNS，逗号分隔；留空使用后端默认
DNS_SERVERS=
# 进度刷新间隔（秒）与任务超时（秒）
POLL_INTERVAL=5
TASK_TIMEOUT=1800
