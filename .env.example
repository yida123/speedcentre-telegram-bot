# Telegram Bot Token（从 @BotFather 获取）
TG_BOT_TOKEN=123456:ABC-DEF
# SpeedCentre+ 用户 API Key
SCP_API_KEY=your-api-key
# API 地址，一般无需修改
SCP_API_BASE=https://api.speedcentre.plus

# 允许使用 bot 的群组 ID，逗号分隔（先留空，在群里发 /id 拿到后再填；留空表示任何群都能用，会消耗你的积分）
ALLOWED_CHAT_IDS=
# 管理员用户 ID，逗号分隔；管理员测速不限次数，并可操作他人的菜单、取消他人任务
ADMIN_USER_IDS=

# 固定测速的订阅配置文件（参考 subscriptions.example.yaml）
SUBSCRIPTIONS_FILE=subscriptions.yaml
# 每人每天最多测速次数，0 表示不限；管理员不受限制
DAILY_LIMIT=3
# “每天”按哪个时区计算
TIMEZONE=Asia/Shanghai
# 测速次数记录的保存目录（systemd 部署时由服务自动设置为 /var/lib/speed-bot）
DATA_DIR=data

# 单次测试最多节点数
MAX_NODES=100
# 每个群同时运行的任务数
MAX_TASKS_PER_CHAT=1
# 默认后端 ID，留空自动选择
DEFAULT_SLAVE_ID=
# 允许用户选择的后端 ID，逗号分隔；留空表示所有允许 Copilot 调用的在线后端（见 /backends）
ALLOWED_BACKENDS=
# 测速前是否让用户用按钮选择后端（true/false）
BACKEND_SELECT=true
# 测速前是否让用户选择结果排序方式（true/false）；关闭时按平均速度降序
SORT_SELECT=true
# 网页查看任务的链接模板，{task_id} 会被替换；留空则不显示「在 SpeedCentre+ 查看」按钮
SCP_TASK_URL=
# 分享页链接模板，{uuid} 会被替换为分享 ID；留空则不创建分享、不显示「查看详情」按钮
SCP_SHARE_URL=
# 群里出现节点链接或疑似订阅链接时自动删除（防止订阅泄露，需要 bot 是群管理员并有删除消息权限）
DELETE_SUB_MESSAGE=true
# 判断“疑似订阅链接”的正则（匹配 http/https 链接），留空使用内置规则
SUB_LINK_PATTERN=
# 进度刷新间隔（秒）与任务超时（秒）
POLL_INTERVAL=5
TASK_TIMEOUT=1800
